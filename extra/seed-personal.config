# =============================================================
# 个人精简版 seed（xg-040g-md / xg-040g-mf 专用，按用户指定）
# 只含：PON 基础栈 + LuCI(官方默认 bootstrap/简体中文)
#       + QModem 全功能(v3.2.0) + OpenClash(插件不带内核)
#       + USB 4G/5G 驱动
# 明确不含：主题(Aurora/Argon/Vantage)、Passwall、EIP93/cryptodev、
#           BBR/RPS/代理调优、cpufreq、airoha-npu 界面
# =============================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# ---- PON / ONU 基础（光口认证拨号核心） ----
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y
# ---- QModem 全功能 (v3.2.0；hc 为 mediatek 专用不含) ----
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_qfirehose=y
# 互斥说明：luci-app-qmodem-next 与 luci-app-qmodem 抢概览页 11_modem.js，只能留主界面
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-monitor=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y
CONFIG_PACKAGE_luci-app-qmodem-mwan=y
# 互斥说明：ttl(iptables/fw3) 与 ttlfw4(nft/firewall4) 抢同一套 config/init 文件，PonWrt 用 fw4 只留 ttlfw4
CONFIG_PACKAGE_luci-app-qmodem-ttlfw4=y
# ---- 短信转发：forwarder 与 forwarder-next 共用 etc/init.d/sms_forwarder，互斥 ----
# 留传统版：luci-app-qmodem-sms 短信界面官方依赖 +sms-forwarder，链路 tom_modem→forwarder→界面
CONFIG_PACKAGE_sms-forwarder=y
# ---- NPU 监控 + CPU 频率控制 + PLL 超频 (rchen14b 版，支持 AN7581/AN7583) ----
CONFIG_PACKAGE_luci-app-airoha-npu=y
# 超频/寄存器读取依赖：busybox devmem applet + 内核 /dev/mem
# （busybox 子项默认锁定，必须先开 BUSYBOX_CUSTOM 才能手动选 DEVMEM）
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_KERNEL_DEVMEM=y
# ---- USB 4G/5G 驱动 ----
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_chat=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT=y
CONFIG_PACKAGE_kmod-mtk-t7xx=y
# ---- OpenClash（仅插件，内核由用户自行下载） ----
CONFIG_PACKAGE_luci-app-openclash=y
# ---- Argon 主题（immortalwrt 官方 feed 收录，设为默认） ----
CONFIG_PACKAGE_luci-theme-argon=y
# ---- 构建加速（不进固件） ----
CONFIG_CCACHE=y
